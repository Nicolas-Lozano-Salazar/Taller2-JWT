# Puerto en el que escucha la API
PORT=3000

# Ruta (relativa a backend/) del archivo de base de datos SQLite
DB_PATH=data/inventario.db

# Origen permitido para CORS (* en desarrollo)
CORS_ORIGIN=*

# Carga automatica de los 10 productos de prueba si la tabla esta vacia
SEED=true

# Entorno de ejecucion
NODE_ENV=development
